 "client_script": "frappe.web_form.after_load = function() {\n    const frm = frappe.web_form;\n\n    // If checkbox is already checked\n    if (frm.get_value('vehicle_pick_up')) {\n        populate_pickup_address(frm);\n        frm.set_df_property('car_repair_images', 'reqd', 1);\n    }\n\n    // Listen for checkbox changes\n    frappe.web_form.on('vehicle_pick_up', function(value) {\n        if (value) {\n            populate_pickup_address(frm);\n            frm.set_df_property('car_repair_images', 'reqd', 1);\n        } else {\n            frm.set_value('pick_up_address', '');\n            frm.set_df_property('car_repair_images', 'reqd', 0);\n        }\n    });\n};\n\nfunction populate_pickup_address(frm) {\n    if (navigator.geolocation) {\n        navigator.geolocation.getCurrentPosition(async function(position) {\n            const lat = position.coords.latitude;\n            const lng = position.coords.longitude;\n\n            try {\n                const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`);\n                const data = await response.json();\n                const address = data.display_name || `${lat}, ${lng}`;\n                frm.set_value('pick_up_address', address);\n            } catch (err) {\n                frappe.msgprint(__('Unable to fetch address from location.'));\n            }\n        }, function(error) {\n            frappe.msgprint(__('Unable to fetch location! Please allow location access.'));\n        });\n    } else {\n        frappe.msgprint(__('Geolocation is not supported by your browser.'));\n    }\n}\n",
